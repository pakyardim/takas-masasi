# developer.yahoo.com/apps -> Create an App (API Permissions: Fantasy Sports - Read)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Lig sayfasının URL'sindeki numara: basketball.fantasysports.yahoo.com/nba/12345
YAHOO_LEAGUE_ID=
# Yahoo uygulamasında tanımladığın redirect URI ile aynı olmalı
YAHOO_REDIRECT_URI=oob
# 1 yaparsan Yahoo ayarları olsa bile demo veriyle çalışır
DEMO=0
