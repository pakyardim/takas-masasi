{
  "manifest_version": 3,
  "name": "Takas Masası – Yahoo Senkron",
  "version": "0.6.0",
  "description": "Yahoo Fantasy NBA liginin kadro ve istatistiklerini okuyup yerel Takas Masası uygulamasına aktarır.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://basketball.fantasysports.yahoo.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Takas Masası",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
